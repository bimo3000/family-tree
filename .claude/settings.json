{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npm ls *)",
      "Bash(npm view *)",
      "Bash(npm outdated)",
      "Bash(npx playwright test *)",
      "Bash(npx playwright show-report)",
      "Bash(npx vitest *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(npx svelte-check *)",
      "Bash(npx vite build)",
      "Bash(node scripts/*)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push origin main)",
      "Bash(git check-ignore *)",
      "Bash(git ls-files *)"
    ],
    "deny": [
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Read(./data/**)",
      "Edit(./data/**)"
    ]
  }
}
