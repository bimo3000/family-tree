# Maintained by the agents developing this repo (see CLAUDE.md → "Housekeeping").
# Rule of thumb: build output, caches, local tooling state and REAL FAMILY DATA never get committed.

# --- Dependencies & tooling caches ---
node_modules/
.npm/
.eslintcache
.prettiercache
*.tsbuildinfo
.vite/
.svelte-kit/

# --- Build output (always reproducible via npm scripts) ---
# The app folder Stammbaum/ IS committed: `npm run release` refreshes it when a version is released (ADR-0002).
dist/

# --- Test output ---
test-results/
playwright-report/
blob-report/
playwright/.cache/
coverage/

# --- Real family data: NEVER commit (privacy, see PRIV-03 in docs/requirements) ---
# Local working folder for your own family-tree projects:
data/
# Any project file anywhere in the repo, except the fictional example built by `npm run release`:
*.stammbaum
!/Stammbaum/Beispiel.stammbaum
# Loose photos dropped into the repo root by accident
/*.jpg
/*.jpeg
/*.png
/*.heic

# --- Secrets & environment ---
.env
.env.*
!.env.example

# --- Claude Code: personal (non-shared) settings ---
.claude/settings.local.json

# --- Editors & OS junk ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Logs & temp files ---
*.log
npm-debug.log*
tmp/
.tmp/
